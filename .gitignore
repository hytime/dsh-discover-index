# Dependencies
node_modules/

# pnpm store, when it is configured inside the project.
.pnpm-store/

# Build output. `dist/` holds compiled JS and is never published;
# `dist/site/` holds the indexes and the statistics page, which are.
# Both are produced by CI and never committed.
dist/

# The Git-resolution cache: per-run, environment-specific, and large.
# Snapshot policy for committed upstream fixtures is a separate decision the
# maintainers own, so nothing under data/ is ignored except this cache file.
data/resolve-cache.json

# TypeScript incremental build state
*.tsbuildinfo

# Logs
*.log

# MemSearch memory: per-project, machine-local session journals and the derived
# Milvus index state. Markdown is the source of truth for memory, but it records
# this machine's conversations rather than repository content, so it is not
# committed.
.memsearch/

# OS noise
.DS_Store

# pnpm-lock.yaml is intentionally NOT ignored: CI installs with
# --frozen-lockfile, so the lockfile must be committed.
